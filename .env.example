# Local development environment variables
# Copy this file to `.env` before starting: the API and drizzle-kit load it
# automatically, while real environment variables take precedence.
# Add application-specific variables as they are introduced.

# PostgreSQL
POSTGRES_DB=local_ai_control_plane
POSTGRES_USER=local_ai_control_plane
POSTGRES_PASSWORD=local_development_password
POSTGRES_PORT=5432
# Connection string used by the API and drizzle-kit. Keep it in sync with the
# POSTGRES_* values above. The API and drizzle-kit fail when it is not set.
DATABASE_URL=postgresql://local_ai_control_plane:local_development_password@localhost:5432/local_ai_control_plane

# GitHub App (M1 webhook + future operator OAuth)
GH_APP_ID=your_app_id_here
GH_APP_PRIVATE_KEY=your_private_key_here
GH_WEBHOOK_SECRET=your_webhook_secret_here

# Internal agent / service credential for review-run APIs (M1).
# Operators and public webhooks must not use this token.
INTERNAL_API_TOKEN=your_internal_api_token_here

# Operator JWT signing key (planned; see ADR-0003). Not used until operator auth ships.
JWT_SECRET=your_jwt_secret_here

# mTLS / Node Identity (node-facing surface; see ADR-0002 / ADR-0003)
NODE_TLS_CA_PATH=.dev-certs/ca.crt
NODE_TLS_CERT_PATH=.dev-certs/server.crt
NODE_TLS_KEY_PATH=.dev-certs/server.key
# Reject client certificates not signed by the CA. Set to false for local
# development only; the API still requires a client certificate to be present.
# M1 public webhook and Bearer-authenticated agent routes must not rely on
# global client-cert enforcement (separate listener or relaxed surface).
NODE_TLS_ENFORCE_CLIENT_CA=true

# Context7 MCP: Set this in your system environment, not in .env.
#   export CONTEXT7_API_KEY="your_key_here"
