{
  "name": "local-ai-control-plane",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "db:migrate": "pnpm --filter control-plane-api exec drizzle-kit migrate",
    "db:reset": "docker compose down -v && docker compose up -d --wait --wait-timeout 90 && pnpm db:migrate",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "turbo": "^2.10.12",
    "prettier": "^3.9.4"
  }
}
